# Git Submodules for OpenSpec-Superpowers Integration
# These files enable specification-driven development (SDD) workflow
[submodule "OpenSpec"]
	path = OpenSpec
	url = https://github.com/Noonz78/OpenSpec.git
	update = checkout
[submodule "superpowers"]
	path = superpowers
	url = https://github.com/obra/superpowers.git
	update = checkout
