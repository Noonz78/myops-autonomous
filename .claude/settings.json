{
  "model": "qwen3.5:9b",
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",

  "autonomousMode": true,

  "permissions": {
    "allow": [
      "Read",
      "Write(.claude)",
      "Write(.scratch)",
      "Edit(.claude)",
      "Edit(.scratch)",
      "Glob(.claude)",
      "Glob(.scratch)",
      "Bash(*)",
      "Edit",
      "Write",
      "NotebookEdit"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(dd *)",
      "Bash(: *)",
      "Bash(> /dev/null)"
    ],
    "defaultMode": "acceptEdits"
  },

  "openSpecIntegration": {
    "enabled": true,
    "status": "CLONED - READY",
    "repoUrl": "https://github.com/Fission-AI/OpenSpec.git",
    "actionRequired": null
  },

  "superpowersIntegration": {
    "enabled": true,
    "status": "CLONED - READY",
    "repoUrl": "https://github.com/obra/superpowers.git",
    "actionRequired": null
  },

  "agentCapabilities": {
    "taskManagement": true,
    "planning": true,
    "research": true,
    "crossFileContext": true,
    "note": "OpenSpec and Superpowers are now cloned. For full integration with skills/tools, install the OpenSpec CLI globally and register the Superpowers plugin for Claude Code."
  },

  "memory": {
    "persistAcrossSessions": true,
    "location": ".claude/memory",
    "startupPromptLocation": ".scratch/STARTUP-PROMPT.md"
  }
}
