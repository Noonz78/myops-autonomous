{
  "model": "qwen3.5:9b",
  "effortLevel": "xhigh",
  "verbose": true,
  "showTurnDuration": false,

  "autonomousMode": true,
  "autoCreateTasks": true,
  "persistAcrossSessions": true,

  "openSpec": {
    "enabled": true,
    "autoGenerateDocs": true,
    "specLocation": "docs/specs"
  },

  "memory": {
    "location": ".claude/memory",
    "autoSummarize": true,
    "keepHistory": 100
  },

  "plugins": {
    "taskList": true,
    "cron": true,
    "agent": true,
    "plan": true,
    "notebookEdit": true
  }
}
